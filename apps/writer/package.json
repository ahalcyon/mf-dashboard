{
  "name": "@mf-dashboard/writer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:@libsql/client --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@libsql/client": "catalog:",
    "@mf-dashboard/db": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.160",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
