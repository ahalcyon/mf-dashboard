{
  "name": "@mf-dashboard/crawler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth/login": "./src/auth/login.ts",
    "./auth/state": "./src/auth/state.ts",
    "./browser/context": "./src/browser/context.ts",
    "./scrapers/group": "./src/scrapers/group.ts",
    "./scrapers/cash-flow-history": "./src/scrapers/cash-flow-history.ts",
    "./scrapers/monthly-summary": "./src/scrapers/monthly-summary.ts",
    "./scrapers/portfolio": "./src/scrapers/portfolio.ts",
    "./scrapers/liabilities": "./src/scrapers/liabilities.ts",
    "./sync/config": "./src/sync/config.ts",
    "./sync/publisher": "./src/sync/publisher.ts",
    "./scrapers/refresh": "./src/scrapers/refresh.ts",
    "./logger": "./src/logger.ts",
    "./browser/launch-args": "./src/browser/launch-args.ts"
  },
  "scripts": {
    "dev:scrape": "DEBUG=true SKIP_REFRESH=true tsx src/index.ts",
    "dev:prod": "tsx src/server.ts",
    "serve": "tsx src/server.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sns": "^3.1116.0",
    "@aws-sdk/client-sqs": "^3.1111.0",
    "@aws-sdk/client-ssm": "^3.1111.0",
    "@mf-dashboard/date-utils": "workspace:*",
    "@mf-dashboard/db": "workspace:*",
    "@mf-dashboard/meta": "workspace:*",
    "drizzle-orm": "catalog:",
    "playwright": "catalog:",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
