# 既定値のままでも apply できる。上書きしたい項目だけコメントを外す。

# aws_profile = "default"
# region      = "ap-northeast-1"
# name_prefix = "mf-dashboard"

# 独自ドメインを使う場合は両方を設定する（証明書は us-east-1 に必要）
# hostname            = "dashboard.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"

# 1 日 2 回、6:30 と 15:30 (Asia/Tokyo)
# schedule_expression = "cron(30 6,15 * * ? *)"
# schedule_timezone   = "Asia/Tokyo"

# 定期クロールを有効にする
# enable_crawler_schedule = true

# イメージのビルドに使う Docker 互換 CLI。
# Windows で開発する場合は WSL Container CLI を指す。
# container_cli = "/mnt/c/Program Files/WSL/wslc.exe"

# クロール結果の通知先。設定すると AWS から確認メールが届くので承認する。
# notification_email = "user-a@example.com"
